{
  "name": "navel-website",
  "private": true,
  "version": "0.2.7",
  "type": "module",
  "scripts": {
    "create-admin": "node scripts/create-admin.js",
    "merge-locales": "node scripts/merge-privacy-locales.js && node scripts/merge-rgpd-locales.js && node scripts/apply-pt-ui-patch.mjs && node scripts/apply-es-ui-patch.mjs && node scripts/merge-istobal-i18n.mjs",
    "prebuild": "node scripts/sync-documentos-api-config.mjs && npm run merge-locales",
    "dev": "vite",
    "build": "vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "optimize-images": "node scripts/optimize-images.js",
    "kill-preview": "node scripts/kill-preview-ports.js",
    "build:fresh": "npm run kill-preview && npm run optimize-images && npm run build",
    "make-zip": "node scripts/make-zip.js",
    "cpanel:pack": "node scripts/cpanel-full-upload.mjs",
    "deploy:probe": "node scripts/cpanel-probe.mjs",
    "deploy:dry": "node scripts/cpanel-deploy.mjs --all --dry",
    "deploy:php": "node scripts/cpanel-deploy.mjs --php",
    "deploy:site": "node scripts/cpanel-deploy.mjs --site",
    "deploy:zips": "node scripts/cpanel-deploy.mjs --zips",
    "deploy:file": "node scripts/cpanel-deploy.mjs",
    "deploy:all": "node scripts/cpanel-deploy.mjs --all",
    "deploy:at-manut": "node scripts/cpanel-deploy.mjs --at-manut",
    "cpanel:hygiene": "node scripts/cpanel-server-hygiene.mjs",
    "test:onedrive-cron": "node scripts/test-onedrive-cron-now.mjs"
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.324",
    "@supabase/supabase-js": "^2.95.3",
    "i18next": "^23.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^14.0.0",
    "react-router-dom": "^6.22.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "archiver": "^7.0.1",
    "basic-ftp": "^5.3.0",
    "sharp": "^0.34.5",
    "ssh2-sftp-client": "^12.1.1",
    "vite": "^5.1.0",
    "puppeteer": "^24.2.0"
  }
}
