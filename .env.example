# Supabase — criar projeto em https://supabase.com e copiar valores
# Copiar para .env antes de executar
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
#
# Em cada `npm run build`, o script scripts/sync-documentos-api-config.mjs copia estes
# valores para public/documentos-api-config.php (gitignored), para o PHP validar tokens
# na área reservada. Sem isto, documentos-api.php devolve invalid_token no cPanel.

# Opcional: documentos da área reservada no disco do servidor (PHP em public/documentos-api.php)
# em vez do Storage Supabase. Ver docs/CPANEL-DOCUMENTOS.md
# VITE_DOCUMENTOS_API=/documentos-api.php

# Opcional: para scripts (ex: create-admin.js). Obter em Settings → API → service_role
# NUNCA expor no frontend
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Opcional: password inicial do admin ao correr `npm run create-admin`.
# Se omitido, o script gera uma password aleatória e imprime-a no terminal.
# SUPABASE_ADMIN_PASSWORD=troque-me

# Opcional: chat Tawk.to (ver docs/TAWKTO-CHATBOT.md).
# Sem estas variáveis, o widget não é carregado (fallback seguro).
# VITE_TAWK_PROPERTY_ID=xxxxxxxxxxxxxxxxxxxxxxxx
# VITE_TAWK_WIDGET_ID=default
