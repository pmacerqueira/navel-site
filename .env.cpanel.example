# ============================================================================
# Credenciais para deploy automático para cPanel — ÂMBITO: www.navel.pt
# ============================================================================
# ATENÇÃO: este ficheiro é EXCLUSIVO do projecto `navel-site`. Outros
# projectos NAVEL (app-stocks-next em Vercel, AT_Manut, etc.) têm destinos
# e ferramentas próprias — NÃO copiar este ficheiro para outros repos.
#
# Os scripts `cpanel-probe.mjs` / `cpanel-deploy.mjs` abortam com erro se:
#   - Forem executados fora da pasta `navel-site/`.
#   - CPANEL_HOST / CPANEL_FTP_HOST / CPANEL_SFTP_HOST não estiverem em
#     `navel.pt` (ou subdomínios).
#
# Passos:
#   1. Copia este ficheiro para: .env.cpanel
#   2. Preenche apenas o bloco do(s) protocolo(s) que vais usar.
#   3. .env.cpanel está no .gitignore — NUNCA entra no repositório.
#   4. Confirma as opções disponíveis com: npm run deploy:probe
#
# Regras de segurança:
#   - NÃO uses a conta cPanel principal. Cria uma conta FTP dedicada.
#   - NÃO partilhes este ficheiro com ninguém (incluindo AI/chats).
#   - Revoga credenciais se suspeitares de fuga.
# ============================================================================

# Host principal (sem https:// nem barras). Igual para FTPS, SFTP e API.
CPANEL_HOST=navel.pt

# Pasta remota de destino (tipicamente public_html).
# Se a conta FTP dedicada já abre dentro de public_html, deixa apenas "/".
CPANEL_REMOTE_ROOT=/public_html

# Opcional: URL canónica do site (https, sem barra final). Usado só por
# `npm run cpanel:hygiene` para gerar os comandos de cron. Default: https://navel.pt
# CPANEL_PUBLIC_URL=https://navel.pt

# Protocolo ativo para o deploy. Valores: ftps | sftp | uapi
# (Podes mudar sem apagar os restantes blocos; o probe testa todos.)
CPANEL_PROTOCOL=ftps

# ---------------------------------------------------------------------------
# A) FTPS — FTP sobre TLS (recomendado; universal em todos os planos cPanel)
# ---------------------------------------------------------------------------
# No cPanel: "FTP Accounts" → cria uma conta ex: deploy@navel.pt, limita a
# pasta public_html/. Host costuma ser ftp.navel.pt (ou navel.pt); porta 21.
CPANEL_FTP_HOST=ftp.navel.pt
CPANEL_FTP_PORT=21
CPANEL_FTP_USER=deploy@navel.pt
CPANEL_FTP_PASSWORD=
# Forçar TLS (true). Se a tua cPanel não aceitar FTPS, o probe avisa.
CPANEL_FTP_SECURE=true
# Validação estrita do hostname no certificado TLS (true por defeito).
# Muitos alojamentos partilhados (Ciberserver, etc.) usam um certificado
# válido para o hostname interno (ex.: pplcXXXXX.ciberserver.com) mas não
# para ftp.seu-dominio.com — a ligação continua encriptada mas o nome
# não bate. Põe false para aceitar o certificado sem validar hostname.
# Alternativa mais puritana: deixar true e usar o hostname do certificado
# em CPANEL_FTP_HOST.
CPANEL_FTP_TLS_STRICT=true

# ---------------------------------------------------------------------------
# B) SFTP — SSH (só se o teu plano tiver SSH ativo; muitos planos shared não têm)
# ---------------------------------------------------------------------------
# No cPanel: "SSH Access". Porta típica: 22 (alguns hosts usam 2222).
# Preferencial usar chave privada em vez de password.
CPANEL_SFTP_HOST=navel.pt
CPANEL_SFTP_PORT=22
CPANEL_SFTP_USER=
CPANEL_SFTP_PASSWORD=
# Caminho absoluto para a chave privada (ex.: C:\\Users\\Pedro\\.ssh\\id_ed25519).
# Se usares chave, deixa a password vazia (ou coloca a passphrase da chave).
CPANEL_SFTP_KEY_PATH=
CPANEL_SFTP_PASSPHRASE=

# ---------------------------------------------------------------------------
# C) cPanel API Token (UAPI) — alternativa HTTPS, sem FTP/SSH
# ---------------------------------------------------------------------------
# No cPanel: "Manage API Tokens" → Create. Cola aqui o token (só é mostrado 1 vez).
# Usa a porta 2083 (HTTPS do cPanel).
CPANEL_API_USER=
CPANEL_API_TOKEN=
CPANEL_API_PORT=2083
